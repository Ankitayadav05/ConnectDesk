<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mini Whatsapp</title>
  <link rel="stylesheet" href="style.css"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="bg-light">

    <div class="container py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">All Chats!</h2>

            <form method="GET" action="/chats/new">
                <button class="btn btn-primary">New Chat</button>
            </form>
        </div>

        <% for( let chat of chats) { %>

            <div class="card shadow-sm mb-3" style="max-width: 500px;">

                <div class="card-body">

                    <p class="mb-2">
                        From: <strong><%= chat.from %></strong>
                    </p>

                    <div class="bg-primary text-white p-3 rounded-3 mb-3">
                        <p class="mb-3"><%= chat.msg %></p>

                        <form method="GET" action="/chats/<%= chat._id %>/edit" class="d-inline">
                            <button class="btn btn-light btn-sm">Edit</button>
                        </form>

                        <form method="POST" action="/chats/<%= chat._id %>/?_method=DELETE" class="d-inline">
                            <button class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>

                    <p class="mb-1">
                        Received by <strong><%= chat.to %></strong>
                    </p>

                    <hr>

                    <small class="text-muted">
                        <%= chat.created_at.toString().split(" ")[4] %>
                        <br>
                        <%= chat.created_at.toString().split(" ").slice(0,4).join("-") %>
                    </small>

                </div>

            </div>

        <% } %>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

</body>
</html>